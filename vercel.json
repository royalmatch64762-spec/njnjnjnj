{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/lobby", "destination": "/index.html" },
    { "source": "/index", "destination": "/index.html" },
    { "source": "/chicken_road", "destination": "/chicken_road.html" },
    { "source": "/chicken-road", "destination": "/chicken_road.html" },
    { "source": "/chickenroad", "destination": "/chicken_road.html" },
    { "source": "/aviator", "destination": "/aviator.html" },
    { "source": "/avator", "destination": "/aviator.html" },
    { "source": "/rocket_mines", "destination": "/rocket_mines.html" },
    { "source": "/rocket-mines", "destination": "/rocket_mines.html" },
    { "source": "/rocketmines", "destination": "/rocket_mines.html" },
    { "source": "/neon_spins", "destination": "/neon_spins.html" },
    { "source": "/neon-spins", "destination": "/neon_spins.html" },
    { "source": "/neonspins", "destination": "/neon_spins.html" },
    { "source": "/desert_axe", "destination": "/desert_axe.html" },
    { "source": "/desert-axe", "destination": "/desert_axe.html" },
    { "source": "/desertaxe", "destination": "/desert_axe.html" },
    { "source": "/desert_fortune", "destination": "/desert_fortune.html" },
    { "source": "/desert-fortune", "destination": "/desert_fortune.html" },
    { "source": "/desertfortune", "destination": "/desert_fortune.html" },
    { "source": "/flappy_checkpoint", "destination": "/flappy_checkpoint.html" },
    { "source": "/flappy-checkpoint", "destination": "/flappy_checkpoint.html" },
    { "source": "/flappy", "destination": "/flappy_checkpoint.html" },
    { "source": "/ladder_and_snakes", "destination": "/ladder_and_snakes.html" },
    { "source": "/ladder-and-snakes", "destination": "/ladder_and_snakes.html" },
    { "source": "/snakes", "destination": "/ladder_and_snakes.html" },
    { "source": "/tik_tak_win", "destination": "/tik_tak_win.html" },
    { "source": "/tik-tak-win", "destination": "/tik_tak_win.html" },
    { "source": "/tiktakwin", "destination": "/tik_tak_win.html" },
    { "source": "/snakes_and_ladders_2", "destination": "/snakes_and_ladders_2.html" },
    { "source": "/snakes-and-ladders-2", "destination": "/snakes_and_ladders_2.html" },
    { "source": "/glass_roulette", "destination": "/glass_roulette.html" },
    { "source": "/glass-roulette", "destination": "/glass_roulette.html" },
    { "source": "/glassroulette", "destination": "/glass_roulette.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "X-Requested-With, Content-Type, Authorization, Origin, Accept" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *;" }
      ]
    },
    {
      "source": "/pk96-balance.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *;" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|gif|webp|avif|ico|woff|woff2|mp3|wav|ogg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
